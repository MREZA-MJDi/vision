APP_NAME=VISION
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional first-administrator bootstrap (never commit real credentials).
# Existing matching users are promoted without changing their name or password.
COMMERCE_ADMIN_EMAIL=
COMMERCE_ADMIN_NAME="Store Administrator"
COMMERCE_ADMIN_PASSWORD=

# Commerce pricing rules (tax rate is fractional: 0.08 means 8%).
# Currency code and symbol are labels only; changing them never converts existing prices.
COMMERCE_ADMIN_CURRENCY=IRR
COMMERCE_ADMIN_CURRENCY_SYMBOL="تومان"
COMMERCE_ADMIN_TAX_RATE=0
COMMERCE_ADMIN_SHIPPING_FLAT_RATE=0

# Torob Product API v3. Keep the public key as published by Torob; never put tokens or private keys here.
TOROB_PRODUCT_API_ENABLED=true
TOROB_PUBLIC_KEY=MCowBQYDK2VwAyEAt6Mu4T0pBORY11W+QeM35UsmLO3vsf+6yKpFDEImFk0=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment integrations. Keep disabled until the VISION merchant account is approved.
# These providers never use or require the buyer's card number on the VISION website.
SNAPPAY_ENABLED=false
SNAPPAY_BASE_URL=https://api.snapppay.ir
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=

TOROBPAY_ENABLED=false
TOROBPAY_BASE_URL=https://api.torobpay.com
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=
TOROBPAY_AUTO_SETTLE=false

DIGIPAY_ENABLED=false
DIGIPAY_BASE_URL=https://api.mydigipay.com
DIGIPAY_SANDBOX=false
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_TICKET_TYPE=11
# Required only for DigiPay credit/BNPL ticket types (5/13), as assigned by DigiPay.
DIGIPAY_SELLER_ID=
DIGIPAY_SUPPLIER_ID=
DIGIPAY_CATEGORY_ID=
